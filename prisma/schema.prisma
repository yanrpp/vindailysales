// Prisma Schema for Vercel Postgres / PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. User & Authentication
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String?
  passwordHash String    @map("password_hash")
  role         String    @default("user") // "admin" | "user"
  isActive     Boolean   @default(true) @map("is_active")
  isApproved   Boolean   @default(false) @map("is_approved")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([role, isActive])
  @@map("users")
}

// 2. Daily Sales Report (หัวรายงานยอดขายประจำวัน)
model DailySaleReport {
  id         String          @id @default(uuid())
  reportDate String?         @map("report_date")
  store      String?
  category   String?
  printedAt  DateTime?       @map("printed_at")
  filename   String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  items      DailySaleItem[]

  @@index([reportDate])
  @@index([reportDate, store])
  @@map("daily_sale_reports")
}

// 3. Daily Sales Items (รายการยอดขาย)
model DailySaleItem {
  id          String          @id @default(uuid())
  reportId    String          @map("report_id")
  report      DailySaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  itemNo      Int?            @map("item_no")
  itemCode    String          @map("item_code")
  itemName    String          @map("item_name")
  unit        String?
  quantity    Float           @default(0)
  unitPrice   Float           @default(0) @map("unit_price")
  totalAmount Float           @default(0) @map("total_amount")
  itemType    String?         @map("item_type")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([reportId])
  @@index([itemCode])
  @@index([itemType])
  @@map("daily_sale_items")
}

// 4. Date Report (สำหรับระบบคลังสินค้า)
model DateReport {
  id         String    @id @default(uuid())
  detailDate String    @unique @map("detail_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@index([detailDate])
  @@map("date_report")
}

// 5. Products (ข้อมูลสินค้าในคลัง)
model Product {
  id            String       @id @default(uuid())
  productCode   String       @map("product_code")
  description   String?
  um            String?
  cost          Float?
  storeLocation String?      @map("store_location")
  itemType      String?      @map("item_type")
  idDate        String?      @map("id_date")
  dateReport    DateReport?  @relation(fields: [idDate], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  lots          ProductLot[]

  @@index([productCode])
  @@index([storeLocation])
  @@index([itemType])
  @@index([idDate])
  @@index([productCode, storeLocation])
  @@map("products")
}

// 6. Product Lots (Lot สินค้า และจำนวนคงเหลือ)
model ProductLot {
  id                 String               @id @default(uuid())
  productId          String               @map("product_id")
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNo              String               @map("lot_no")
  exp                DateTime?
  qty                Float                @default(0)
  store              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  stockRecords       ProductStockRecord[]

  @@unique([productId, lotNo])
  @@index([productId])
  @@index([lotNo])
  @@index([exp])
  @@index([productId, exp])
  @@map("product_lots")
}

// 7. Product Stock Records (ประวัติยอดสต็อก)
model ProductStockRecord {
  id            String     @id @default(uuid())
  lotId         String     @map("lot_id")
  lot           ProductLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reportDate    DateTime   @map("report_date")
  qty           Float      @default(0)
  storeLocation String?    @map("store_location")
  um            String?
  cost          Float?
  otherData     Json?      @map("other_data")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([lotId])
  @@index([reportDate])
  @@map("product_stock_records")
}

// 8. Import Batch (ประวัติการนำเข้าไฟล์รายงาน)
model ImportBatch {
  id           String              @id @default(uuid())
  fileType     String              @map("file_type") // "BALANCE" | "DISPENSE" | "SALE" | "USAGE"
  fileName     String              @map("file_name")
  totalRows    Int                 @default(0) @map("total_rows")
  importedRows Int                 @default(0) @map("imported_rows")
  fileSize     Int?                @map("file_size")
  uploadedBy   String?             @map("uploaded_by")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  balances     InventoryBalance[]
  dispenses    InventoryDispense[]
  sales        InventorySale[]
  usages       InventoryUsage[]

  @@index([fileType, createdAt])
  @@map("import_batches")
}

// 9. Inventory Balance (ข้อมูลคงเหลือจากไฟล์ 1.คงเหลือ.xls)
model InventoryBalance {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col D
  balanceQty  Float?       @map("balance_qty") // Col E (จำนวน)
  minQty      Float?       @map("min_qty") // Col H (Min/ความปลอดภัย)
  unitPrice   Float?       @map("unit_price") // Col F
  totalCost   Float?       @map("total_cost") // Col G
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@map("inventory_balances")
}

// 10. Inventory Dispense (ข้อมูลตัดจ่ายจากไฟล์ 2.ตัดจ่าย.xls)
model InventoryDispense {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col F
  rawQty      Float        @map("raw_qty") // Col G ดั้งเดิม
  adjustedQty Float        @map("adjusted_qty") // คำนวณ (G/3)+G
  unitPrice   Float?       @map("unit_price") // Col H
  totalCost   Float?       @map("total_cost") // Col I
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@map("inventory_dispenses")
}

// 11. Inventory Sale (ข้อมูลยอดขายจากไฟล์ 3.ขาย.xls)
model InventorySale {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col F
  rawQty      Float?       @map("raw_qty") // Col E ดั้งเดิม
  adjustedQty Float?       @map("adjusted_qty") // คำนวณ (E/3)+E
  saleAmount  Float?       @map("sale_amount") // Col G
  costAmount  Float?       @map("cost_amount") // Col H
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@map("inventory_sales")
}

// 12. Inventory Usage & Vendor (ข้อมูลปริมาณการใช้ย้อนหลัง หมวด และบริษัท จากไฟล์ 4.ปริมาณการใช้.xls)
model InventoryUsage {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col D
  usageMonth1 Float?       @map("usage_month_1") // ปริมาณการใช้ 6
  usageMonth2 Float?       @map("usage_month_2") // ปริมาณการใช้ 7
  usageMonth3 Float?       @map("usage_month_3") // ปริมาณการใช้ 8
  category    String?      // หมวด
  supplier    String?      // บริษัทคู่ค้า
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([category])
  @@index([supplier])
  @@index([batchId])
  @@map("inventory_usages")
}
