// Prisma Schema for Vercel Postgres / PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. User & Authentication
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String?
  passwordHash String    @map("password_hash")
  role         String    @default("user") // "admin" | "user"
  isActive     Boolean   @default(true) @map("is_active")
  isApproved   Boolean   @default(false) @map("is_approved")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  driveItems        DriveItem[]      @relation("OwnedDriveItems")
  driveSharesToMe   DriveShare[]     @relation("SharedWithUser")
  driveSharesByMe   DriveShare[]     @relation("SharedByUser")

  @@index([role, isActive])
  @@map("users")
}

// 2. Daily Sales Report (หัวรายงานยอดขายประจำวัน)
model DailySaleReport {
  id         String          @id @default(uuid())
  reportDate String?         @map("report_date")
  store      String?
  category   String?
  printedAt  DateTime?       @map("printed_at")
  filename   String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  items      DailySaleItem[]

  @@index([reportDate])
  @@index([reportDate, store])
  @@map("daily_sale_reports")
}

// 3. Daily Sales Items (รายการยอดขาย)
model DailySaleItem {
  id          String          @id @default(uuid())
  reportId    String          @map("report_id")
  report      DailySaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  itemNo      Int?            @map("item_no")
  itemCode    String          @map("item_code")
  itemName    String          @map("item_name")
  unit        String?
  quantity    Float           @default(0)
  unitPrice   Float           @default(0) @map("unit_price")
  totalAmount Float           @default(0) @map("total_amount")
  itemType    String?         @map("item_type")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([reportId])
  @@index([itemCode])
  @@index([itemType])
  @@map("daily_sale_items")
}

// 4. Date Report (สำหรับระบบคลังสินค้า)
model DateReport {
  id         String    @id @default(uuid())
  detailDate String    @unique @map("detail_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@index([detailDate])
  @@map("date_report")
}

// 5. Products (ข้อมูลสินค้าในคลัง)
model Product {
  id            String       @id @default(uuid())
  productCode   String       @map("product_code")
  description   String?
  um            String?
  cost          Float?
  storeLocation String?      @map("store_location")
  itemType      String?      @map("item_type")
  idDate        String?      @map("id_date")
  dateReport    DateReport?  @relation(fields: [idDate], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  lots          ProductLot[]

  @@index([productCode])
  @@index([storeLocation])
  @@index([itemType])
  @@index([idDate])
  @@index([productCode, storeLocation])
  @@map("products")
}

// 6. Product Lots (Lot สินค้า และจำนวนคงเหลือ)
model ProductLot {
  id                 String               @id @default(uuid())
  productId          String               @map("product_id")
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNo              String               @map("lot_no")
  exp                DateTime?
  qty                Float                @default(0)
  store              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  stockRecords       ProductStockRecord[]

  @@unique([productId, lotNo])
  @@index([productId])
  @@index([lotNo])
  @@index([exp])
  @@index([productId, exp])
  @@map("product_lots")
}

// 7. Product Stock Records (ประวัติยอดสต็อก)
model ProductStockRecord {
  id            String     @id @default(uuid())
  lotId         String     @map("lot_id")
  lot           ProductLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reportDate    DateTime   @map("report_date")
  qty           Float      @default(0)
  storeLocation String?    @map("store_location")
  um            String?
  cost          Float?
  otherData     Json?      @map("other_data")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([lotId])
  @@index([reportDate])
  @@map("product_stock_records")
}

// 8. Import Batch (ประวัติการนำเข้าไฟล์รายงาน)
model ImportBatch {
  id           String              @id @default(uuid())
  period       String?             @map("period") // เช่น "2026-10", "2026-11"
  fileType     String              @map("file_type") // "BALANCE" | "DISPENSE" | "SALE" | "USAGE"
  fileName     String              @map("file_name")
  totalRows    Int                 @default(0) @map("total_rows")
  importedRows Int                 @default(0) @map("imported_rows")
  fileSize     Int?                @map("file_size")
  uploadedBy   String?             @map("uploaded_by")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  balances     InventoryBalance[]
  dispenses    InventoryDispense[]
  sales        InventorySale[]
  usages       InventoryUsage[]

  @@index([period])
  @@index([fileType, createdAt])
  @@index([fileType, period])
  @@map("import_batches")
}

// 9. Inventory Balance (ข้อมูลคงเหลือจากไฟล์ 1.คงเหลือ.xls)
model InventoryBalance {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  period      String?      @map("period")
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col D
  balanceQty  Float?       @map("balance_qty") // Col E (จำนวน)
  minQty      Float?       @map("min_qty") // Col H (Min/ความปลอดภัย)
  unitPrice   Float?       @map("unit_price") // Col F
  totalCost   Float?       @map("total_cost") // Col G
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@index([period])
  @@index([period, itemCode])
  @@map("inventory_balances")
}

// 10. Inventory Dispense (ข้อมูลตัดจ่ายจากไฟล์ 2.ตัดจ่าย.xls)
model InventoryDispense {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  period      String?      @map("period")
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col F
  rawQty      Float        @map("raw_qty") // Col G ดั้งเดิม
  adjustedQty Float        @map("adjusted_qty") // คำนวณ (G/3)+G
  unitPrice   Float?       @map("unit_price") // Col H
  totalCost   Float?       @map("total_cost") // Col I
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@index([period])
  @@index([period, itemCode])
  @@map("inventory_dispenses")
}

// 11. Inventory Sale (ข้อมูลยอดขายจากไฟล์ 3.ขาย.xls)
model InventorySale {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  period      String?      @map("period")
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col F
  rawQty      Float?       @map("raw_qty") // Col E ดั้งเดิม
  adjustedQty Float?       @map("adjusted_qty") // คำนวณ (E/3)+E
  saleAmount  Float?       @map("sale_amount") // Col G
  costAmount  Float?       @map("cost_amount") // Col H
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([batchId])
  @@index([period])
  @@index([period, itemCode])
  @@map("inventory_sales")
}

// 12. Inventory Usage & Vendor (ข้อมูลปริมาณการใช้ย้อนหลัง หมวด และบริษัท จากไฟล์ 4.ปริมาณการใช้.xls)
model InventoryUsage {
  id          String       @id @default(uuid())
  batchId     String       @map("batch_id")
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  period      String?      @map("period")
  itemCode    String       @map("item_code") // Col B (ตัวเชื่อม)
  itemName    String?      @map("item_name") // Col C
  unit        String?      // Col D
  balanceQty  Float?       @map("balance_qty") // ยอดคงเหลือจาก Sheet เหลือ (Col E)
  minQty      Float?       @map("min_qty")     // จุดสั่งซื้อ MIN จาก Sheet เหลือ (Col F)
  usageMonth1 Float?       @map("usage_month_1") // ปริมาณการใช้ 6
  usageMonth2 Float?       @map("usage_month_2") // ปริมาณการใช้ 7
  usageMonth3 Float?       @map("usage_month_3") // ปริมาณการใช้ 8
  category    String?      // หมวด
  supplier    String?      // บริษัทคู่ค้า
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([category])
  @@index([supplier])
  @@index([batchId])
  @@index([period])
  @@index([period, itemCode])
  @@map("inventory_usages")
}

// 13. Inventory Pending Delivery (ยอดสินค้าค้างส่ง ที่ผู้ใช้กรอกเพิ่มเติม)
model InventoryPendingDelivery {
  id        String   @id @default(uuid())
  itemCode  String   @unique @map("item_code")
  period    String?  @map("period")
  qty       Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([itemCode])
  @@index([period])
  @@map("inventory_pending_deliveries")
}

// 14. Drive Item (ระบบจัดการไฟล์และโฟลเดอร์สไตล์ Google Drive)
model DriveItem {
  id              String         @id @default(uuid())
  name            String
  type            String         @default("FILE") // "FILE" | "FOLDER"
  mimeType        String?        @map("mime_type")
  size            Int            @default(0) // bytes
  extension       String?
  description     String?
  parentId        String?        @map("parent_id")
  parent          DriveItem?     @relation("DriveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        DriveItem[]    @relation("DriveHierarchy")
  ownerId         String         @map("owner_id")
  owner           User           @relation("OwnedDriveItems", fields: [ownerId], references: [id], onDelete: Cascade)
  isStarred       Boolean        @default(false) @map("is_starred")
  isTrashed       Boolean        @default(false) @map("is_trashed")
  trashedAt       DateTime?      @map("trashed_at")
  isPublic        Boolean        @default(false) @map("is_public")
  shareToken      String?        @unique @map("share_token")
  sharePassword   String?        @map("share_password")
  shareExpiresAt  DateTime?      @map("share_expires_at")
  allowDownload   Boolean        @default(true) @map("allow_download")
  storageType     String         @default("DB") @map("storage_type") // "DB" | "LOCAL" | "BLOB"
  localPath       String?        @map("local_path")
  blobUrl         String?        @map("blob_url")
  color           String?        // สีของโฟลเดอร์
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  blob            DriveFileBlob?
  shares          DriveShare[]

  @@index([ownerId, isTrashed, parentId])
  @@index([ownerId, isStarred, isTrashed])
  @@index([parentId])
  @@index([shareToken])
  @@map("drive_items")
}

// 15. Drive File Blob (เก็บข้อมูลไบนารีของไฟล์ใน PostgreSQL เพื่อให้รันบน Vercel Serverless ได้)
model DriveFileBlob {
  id        String    @id @default(uuid())
  itemId    String    @unique @map("item_id")
  item      DriveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("drive_file_blobs")
}

// 16. Drive Share (การแชร์และรับ-ส่งไฟล์ระหว่างผู้ใช้ในระบบ)
model DriveShare {
  id               String    @id @default(uuid())
  itemId           String    @map("item_id")
  item             DriveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sharedWithUserId String    @map("shared_with_user_id")
  sharedWithUser   User      @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedByUserId   String    @map("shared_by_user_id")
  sharedByUser     User      @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  permission       String    @default("VIEW") // "VIEW" | "EDIT"
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([itemId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([itemId])
  @@map("drive_shares")
}


// 17. Item Type (ประเภทคลัง: 1 = Mainstore, 2 = พัสดุ)
model ItemType {
  id          Int               @id // 1 = MAINSTORE, 2 = SUPPLY (พัสดุ)
  code        String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  locations   StorageLocation[]
  items       LocationItem[]

  @@map("item_types")
}

// 18. Storage Location (ทะเบียนตำแหน่งจัดเก็บ เช่น 1F1, 1B2)
model StorageLocation {
  id          String         @id @default(uuid())
  name        String
  itemTypeId  Int            @map("item_type_id")
  itemType    ItemType       @relation(fields: [itemTypeId], references: [id])
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  items       LocationItem[]

  @@unique([name, itemTypeId])
  @@index([itemTypeId, sortOrder])
  @@map("storage_locations")
}

// 19. Location Item (รายการสินค้าที่อยู่ในแต่ละ Location ตามลำดับ)
model LocationItem {
  id         String          @id @default(uuid())
  locationId String          @map("location_id")
  location   StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  itemTypeId Int             @map("item_type_id")
  itemType   ItemType        @relation(fields: [itemTypeId], references: [id])
  seq        Int             @default(0) // ลำดับภายใน Location
  code       String
  name       String
  unit       String?
  note       String?
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([locationId, code])
  @@index([locationId, seq])
  @@index([code])
  @@index([itemTypeId])
  @@map("location_items")
}
